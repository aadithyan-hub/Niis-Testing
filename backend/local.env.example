# Copy this file to local.env and fill in the values. local.env stays out of git.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0
# Link added to every post; {slug} is replaced. Empty = no link.
SOCIAL_ARTICLE_URL=https://example.com/content/{slug}
SECRET_KEY=local-test-only-secret

# ---- Media library tester ----
MINIO_ENDPOINT=127.0.0.1:9100
MINIO_ACCESS_KEY=niislocal
MINIO_SECRET_KEY=niislocal-secret
MINIO_SECURE=False
MINIO_PUBLIC_URL=http://127.0.0.1:8090
MEDIA_LIBRARY_DELIVERY=redirect
MEDIA_LIBRARY_LINK_SECONDS=300
THROTTLE_LOGIN=100/min
THROTTLE_FORM_SUBMIT=200/min
THROTTLE_CREATE_SUSTAINED=2000/hour
THROTTLE_USER=1000/min

# ---- Mobile reCAPTCHA tab ----
# Credentials file goes in keys/recaptcha-service-account.json (git-ignored).
RECAPTCHA_MOBILE_MODE=
RECAPTCHA_ENTERPRISE_PROJECT_ID=
RECAPTCHA_ANDROID_SITE_KEY=
RECAPTCHA_IOS_SITE_KEY=
